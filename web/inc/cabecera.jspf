<%@ page import="com.sentinel.model.Usuario, com.sentinel.util.Constantes, com.sentinel.util.Html" %>
<%
    Usuario usuarioSesion = (Usuario) session.getAttribute(Constantes.ATTR_USUARIO);
    if (usuarioSesion == null) {
        response.sendRedirect(request.getContextPath() + "/login.jsp");
        return;
    }
    String tituloPagina = (String) request.getAttribute("tituloPagina");
    if (tituloPagina == null) {
        tituloPagina = "Panel de control";
    }
    String moduloActivo = (String) request.getAttribute("moduloActivo");
    if (moduloActivo == null) {
        moduloActivo = "";
    }
    boolean esAdmin = Constantes.ROL_ADMIN.equals(usuarioSesion.getNombreRol());
    String ctx = request.getContextPath();
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= Html.esc(tituloPagina) %> - SENTINELA</title>
    <link rel="icon" href="<%= ctx %>/imagenes/favicon.svg">
    <link rel="stylesheet" href="<%= ctx %>/css/estilos.css">
    <script src="<%= ctx %>/js/app.js" defer></script>
</head>
<body>
<div class="app">

    <header class="topbar">
        <div class="marca">
            <img src="<%= ctx %>/imagenes/logo-sentinel.svg" alt="Logo SENTINELA">
            <div>
                <b>SENTINELA</b>
                <small>SEGURIDAD DIGITAL</small>
            </div>
        </div>
        <div class="espacio"></div>
        <div class="usuario">
            <img src="<%= ctx %>/<%= Html.esc(usuarioSesion.getFoto()) %>" alt="Foto de perfil">
            <div>
                <b><%= Html.esc(usuarioSesion.getNombreCompleto()) %></b>
                <small><%= Html.esc("@" + usuarioSesion.getUsuario()) %></small>
            </div>
            <span class="badge-rol <%= esAdmin ? "admin" : "" %>">
                <%= esAdmin ? "ADMINISTRADOR" : "PERSONAL" %>
            </span>
        </div>
        <a class="btn-salir" href="<%= ctx %>/logout" title="Cerrar sesión">
            <img src="<%= ctx %>/imagenes/icon-salir.svg" alt=""> Salir
        </a>
    </header>

    <div class="cuerpo">
        <aside class="sidebar">
            <%@ include file="menu.jspf" %>
        </aside>

        <main class="contenido">
